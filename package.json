{
  "name": "@sakura12/oh-my-deepseekharness",
  "version": "0.5.2",
  "description": "Multi-agent orchestration layer for DeepSeek Harness — 42 skills, 55 MCP tools, graph DAG runtime, team pipeline & HUD (OMC/OMX adaptation)",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "multi-agent",
    "orchestration",
    "claude-code",
    "oh-my-claudecode",
    "graph-dag",
    "mcp",
    "hud",
    "autopilot",
    "ralph"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1225Sakura/oh-my-deepseekharness.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "mcp-server",
    "assets",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "omd-graph-runner": "bin/graph-runner.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-commands": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.1.3 || >=0.1.5-rc.1 <0.1.6 || >=0.1.7-rc.1 <0.2.0 || >=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-http-proxy": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-storage": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "semver": "^7.8.5",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@ast-grep/napi": "^0.45.3",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3",
    "vscode-uri": "^3.2.0"
  }
}
